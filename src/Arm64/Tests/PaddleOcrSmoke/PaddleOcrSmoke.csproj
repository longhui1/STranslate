<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PlatformTarget>ARM64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <AssemblyName>PaddleOcrSmoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 引用已打包的 SDK，确保测试与用户安装使用相同的程序集身份和字节。 -->
    <Reference Include="STranslate.Plugin" HintPath="$(SmokeAppDirectory)/STranslate.Plugin.dll" Private="true" />
    <Reference Include="CommunityToolkit.Mvvm" HintPath="$(SmokeAppDirectory)/CommunityToolkit.Mvvm.dll" Private="true" />
    <Reference Include="Microsoft.Extensions.Logging.Abstractions" HintPath="$(SmokeAppDirectory)/Microsoft.Extensions.Logging.Abstractions.dll" Private="true" />
    <Compile Include="../../../STranslate/Core/PluginAssemblyLoader.cs" Link="PluginAssemblyLoader.cs" />
    <None Update="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequirePackagedSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SmokeAppDirectory)/STranslate.Plugin.dll')" Text="请通过 SmokeAppDirectory 指定解包后的实际 ARM64 主程序目录。" />
  </Target>
</Project>
